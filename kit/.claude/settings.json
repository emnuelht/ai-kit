{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Task",
      "Agent",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./target/**)",
      "Read(./.next/**)",
      "Read(./coverage/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Read(./package-lock.json)",
      "Read(./yarn.lock)",
      "Read(./pnpm-lock.yaml)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(sudo sh)",
      "Bash(sudo bash)",
      "Bash(mkfs *)",
      "Bash(dd if=* of=/dev/*)",
      "Edit(./.ai/**/*.py)",
      "Edit(./.ai/**/*.sh)",
      "Edit(./.ai/.tools/**)",
      "Write(./.ai/**/*.py)",
      "Write(./.ai/**/*.sh)",
      "Write(./.ai/.tools/**)",
      "Edit(./.ai/design/canvas-local/canvas.html)",
      "Write(./.ai/design/canvas-local/canvas.html)",
      "Edit(./.ai/settings.kit.json)",
      "Write(./.ai/settings.kit.json)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker run *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nmap *)",
      "Bash(masscan *)",
      "Bash(sqlmap *)",
      "Bash(nikto *)",
      "Bash(nuclei *)",
      "Bash(hydra *)",
      "Bash(ffuf *)",
      "Bash(gobuster *)",
      "Bash(dirb *)",
      "Bash(wfuzz *)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git merge *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.mcp.json)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/settings.local.json)",
      "Write(./.claude/hooks/**)",
      "Write(./.mcp.json)"
    ],
    "allow": [
      "Read(./.ai/**)",
      "Edit(./.ai/**)",
      "Write(./.ai/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements)",
      "Bash(winget install -e --id Git.Git --accept-package-agreements --accept-source-agreements)",
      "Bash(brew install python@3.12)",
      "Bash(brew install git)",
      "Bash(echo AI_KIT_GUARD_CANARY)",
      "Bash(command -v *)",
      "Bash(uname*)",
      "Bash(python3 --version)",
      "Bash(python --version)",
      "Bash(py --version)",
      "Bash(python3 .claude/hooks/guard.py --selftest)",
      "Bash(python .claude/hooks/guard.py --selftest)",
      "Bash(py .claude/hooks/guard.py --selftest)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git tag -a *)",
      "Bash(git show*)"
    ]
  },
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "for p in python3 python py; do if \"$p\" -c \"\" </dev/null >/dev/null 2>&1; then exec \"$p\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; fi; done; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
